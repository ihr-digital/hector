  <rdf:Description rdf:nodeID="commodity_heron_cb84daf28b305d0a476b6f44455aa6025de59c4935b5e3e3ff50da9de29cd36e8f">
    <crm:P190_has_symbolic_content>any of various long-necked, long-legged wading birds of the genus Ardea and related genera (family Ardeidae), typically having a crest and nesting colonially, and related to egrets and bitterns; especially the large A. cinerea of Eurasia (OED s.v. heron n.)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
