    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Lighting devices, fixed or portable, designed to protect and enclose the light source, usually with sides of glass, horn, pierced metal, paper, or other material, allowing light to emerge and often having a supporting frame, hanging device, or carrying handle. They may be purely utilitarian or decorative, sometimes having ceremonial significance. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
