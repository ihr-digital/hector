  <rdf:Description rdf:nodeID="commodity_lantern_cb1d1d2ba601e521970d017a1aa8dd1db2545b5cb84ea00034aee636b09ec804b18">
    <crm:P190_has_symbolic_content>Lighting devices, fixed or portable, designed to protect and enclose the light source, usually with sides of glass, horn, pierced metal, paper, or other material, allowing light to emerge and often having a supporting frame, hanging device, or carrying handle. They may be purely utilitarian or decorative, sometimes having ceremonial significance. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
