    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Carbohydrate containing exudates obtained from some trees or shrubs belonging to the family Fabaceae of the pea order Fabales. Gum is insoluble in alcohol and either soluble or swellable in water. Some plant gums are used in the form of water solutions in the manufacture of cosmetics, pharmaceuticals, and foods; when the water evaporates, a film having a considerable adhesive character is formed. Some gums, such as gum arabic, dissolve in water to give clear solutions. Other gums, such as gum tragacanth, form mucilages by the absorption of large amounts of water. May be distinguished from \"resin\" in that gum hardens in drying, but is usually soluble in water. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/gum> ;
    skos:related <https://w3id.org/hector/commodity/gum-arabic>,
        <https://w3id.org/hector/commodity/gum-of-needles> ;
