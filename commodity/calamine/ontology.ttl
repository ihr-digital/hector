    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "A pharmaceutical substance made of zinc oxide with small amount of fenic oxide (to give faint pink color), and containing after ignition, not less than 98% and not more than 100.5% zinc oxide. Commercial calamine may be distributed as a pink lotion, used as a skin protectant and salve. [Source: Getty AAT]" ;
