  <rdf:Description rdf:nodeID="commodity_calamine_cb189afdc0d331d150aba982f6965ecaaf6288f667b3f0031a14dc8cc913736ee38">
    <crm:P190_has_symbolic_content>A pharmaceutical substance made of zinc oxide with small amount of fenic oxide (to give faint pink color), and containing after ignition, not less than 98% and not more than 100.5% zinc oxide. Commercial calamine may be distributed as a pink lotion, used as a skin protectant and salve. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
