  <rdf:Description rdf:nodeID="commodity_wine_cb3218c96b36ff728745aeea62a99747ba6eaa437f5dc63523a344553330b84f7e">
    <crm:P190_has_symbolic_content>wine (Latin vinum); in the customs accounts the default is Gascon wine, with many named types (Rhenish, malmsey, muscadel, romney, bastard, sack...) and origins. Soured wine / vinegar is a distinct concept.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
