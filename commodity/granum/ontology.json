  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "The Kermes or scarlet grain: a red dyestuff consisting of the dried bodies of the pregnant females of the insect Coccus ilicis, formerly supposed to be a berry, gathered from a species of evergreen oak in Southern Europe and North Africa (OED s.v. grain n.1 4a, kermes 1). Used to dye cloth scarlet ('granum pro pannis'). Not to be confused with the homonymous spice grains of paradise (see greynes)."
    }
  ],
