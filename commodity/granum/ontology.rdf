  <rdf:Description rdf:nodeID="commodity_granum_cb132fdd789888752f8c88a5623a8cef2f874bf92e92e0ab524d753386c45c676f6">
    <crm:P190_has_symbolic_content>The Kermes or scarlet grain: a red dyestuff consisting of the dried bodies of the pregnant females of the insect Coccus ilicis, formerly supposed to be a berry, gathered from a species of evergreen oak in Southern Europe and North Africa (OED s.v. grain n.1 4a, kermes 1). Used to dye cloth scarlet ('granum pro pannis'). Not to be confused with the homonymous spice grains of paradise (see greynes).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
