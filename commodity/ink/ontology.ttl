<https://w3id.org/hector/commodity/ink> a crm:E55_Type ;
    rdfs:label "ink" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "inke" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "iŋkə" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ink" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "iŋk" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "ynke" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "iŋkə" ;
            hector:validFrom "1536"^^xsd:gYear ;
            hector:validThrough "1540"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "A fluid medium used for drawings or tracings. An opaque, usually black, pigment is mixed with a vehicle such as water to produce a fluid which can be applied with a pen or brush. Through the end of the 19th century, ink was supplied dried in stick or block form which was ground and mixed with water as needed. At the beginning of this century prepared ink became popular. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/ink> ;
    la:equivalent aat:300015012 ;
    hector:attestationCount 7 ;
    hector:taxation <https://w3id.org/hector/commodity/ink#rate-1558-inward-608>,
        <https://w3id.org/hector/commodity/ink#rate-1558-inward-609> .

