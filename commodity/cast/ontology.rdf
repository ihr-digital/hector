  <rdf:Description rdf:nodeID="commodity_cast_cba2b3cd9c4b395694f820b09a2e6f5fe337eb19fa1d51da58057b799cb109b1c0">
    <crm:P190_has_symbolic_content>as many (herrings, etc.) as are thrown into a vessel at once, a ‘warp’; a set of three or four (OED s.v. cast n. III 16), here as a measure of stockfish | a set of three or four (stockfish) (OED s.v. cast n. 16) | a measure of earthen pots, containing three pots (Willan 24) | a packing unit for earthen pottes, containing 3 C</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
