    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Woad: a blue dyestuff prepared from the leaves of Isatis tinctoria, powdered and fermented (OED s.v. woad n.1). Latin gualda/gualdum. Not to be confused with the timber 'wood' (homonym, see wood) nor with weld, the yellow dye of Reseda luteola (see welde)." ;
            crm:P2_has_type aat:300435416 ] ;
