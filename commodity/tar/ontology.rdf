  <rdf:Description rdf:nodeID="commodity_tar_cb21323793f6e6ed3fa0446b6b3e9391120b573582f5e37cded69cbcb691cd312e1">
    <crm:P190_has_symbolic_content>tarre</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="https://w3id.org/hector/ontology#AttestedVariant"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_E41_Linguistic_Appellation"/>
