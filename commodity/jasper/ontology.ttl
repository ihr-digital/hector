<https://w3id.org/hector/commodity/jasper> a crm:E55_Type ;
    rdfs:label "jasper" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "jaspers" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "dʒaspers" ;
            hector:validFrom "1513"^^xsd:gYear ;
            hector:validThrough "1514"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "jasper" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "dʒasper" ;
            hector:validFrom "1445"^^xsd:gYear ;
            hector:validThrough "1446"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Any red chert or chalcedony. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
