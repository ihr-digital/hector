<https://w3id.org/hector/commodity/jasper#rate-1558-inward-599> a hector:Rate ;
    rdfs:label "1558 inward: Jasper stones beinge beade stones square the C stones 30s" ;
    hector:amount [ a crm:E97_Monetary_Amount ;
            crm:P180_has_currency aat:300411998 ;
            hector:lsd "30s" ;
            hector:valueInPence 360.0 ] ;
    hector:perQuantity [ a crm:E54_Dimension ;
            crm:P90_has_value 100 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/hundred> ] ;
    hector:qualifier [ a crm:E55_Type ;
            rdfs:label "square" ],
        [ a crm:E55_Type ;
            rdfs:label "beinge beade" ;
            crm:P2_has_type hector:AttestedVariant ] ;
    hector:sourceText "Book of Rates 1558, inward, line 599 (transcribed by Stuart Jenks): 'Jasper stones beinge beade stones square the C stones' 30s" ;
    hector:validFrom "1558"^^xsd:gYear ;
    hector:validThrough "1604"^^xsd:gYear .

