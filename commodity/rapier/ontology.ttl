    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Light swords with a long, narrow, double-edged blade and a hilt furnished with extensive protection for the hand, such as arms of the hilt and side rings, a shell guard, or a cup guard. Originally designed for both cutting and thrusting, they developed into purely thrusting swords and became the principal fencing weapons of the 16th and 17th centuries. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
