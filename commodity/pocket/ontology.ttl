    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "pocket (a small poke; cf. poke): a bag or small poke used as a packing unit and measure for wool, hops, feathers and similar dry goods, of no particular size; as a measure of hops about 3 cwt at 112 lb./cwt." ;
