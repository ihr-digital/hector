  <rdf:Description rdf:nodeID="commodity_pocket_cbbb318abf46bffcbbe8a95c6fd00b663370dbe698b0ebce5f40a650ba235dac99">
    <crm:P190_has_symbolic_content>pocket (a small poke; cf. poke): a bag or small poke used as a packing unit and measure for wool, hops, feathers and similar dry goods, of no particular size; as a measure of hops about 3 cwt at 112 lb./cwt.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
