  <rdf:Description rdf:nodeID="commodity_balance_cb1acf338d7e526e97e752e9276551acdf49eb6c76dd5c5b985531a98d53185783b">
    <crm:P190_has_symbolic_content>Scales with a horizontal bar pivoting about a central fulcrum, creating equal-length arms; suspended from the ends of the arms are pans or baskets, in one of which is placed the item being weighed and in the other, a premeasured weight. [Source: Getty AAT]</crm:P190_has_symbolic_content>
