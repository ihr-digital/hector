  <rdf:Description rdf:nodeID="commodity_buskin_cbab4cbb826de117167e320d0bcbfb91981c870685edb7548039d75f1f468e9f21">
    <crm:P190_has_symbolic_content>Calf-high or knee-high boots or light coverings for the foot and leg, typically made from cloth or leather. May be made of decorated silk or other fine fabric; may fit inside a shoe like a stocking; sometimes forming part of the regalia of a monarch or eccesiastic. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
