    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Strong cloth woven in a variety of patterns, in common use for bedding and lining for clothing from the 17th to the 19th century. Prior to the 17th century it was made of worsted, then pure cotton or mixes of cotton and linen became common; today generally a cotton twill with a short nap. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
