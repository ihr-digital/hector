  <rdf:Description rdf:nodeID="commodity_lute_cb1c0c0cb4eebc7cd466b942b394fff31b8da653706e24e7c47f17ce3d7d90286c3">
    <crm:P190_has_symbolic_content>Use specifically for plucked chordophones developed in the European Renaissance, having a large pear-shaped body composed of thin, narrow ribs, a flat top, central circular soundhole covered by a rose, and from seven to ten frets on the neck. For the general class of all chordophones with the plane of the strings running parallel to the resonator and a neck that serves both as string bearer and as handle, see "lutelike chordophones." [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
