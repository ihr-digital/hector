    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Use specifically for plucked chordophones developed in the European Renaissance, having a large pear-shaped body composed of thin, narrow ribs, a flat top, central circular soundhole covered by a rose, and from seven to ten frets on the neck. For the general class of all chordophones with the plane of the strings running parallel to the resonator and a neck that serves both as string bearer and as handle, see \"lutelike chordophones.\" [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
