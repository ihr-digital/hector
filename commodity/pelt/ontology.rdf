  <rdf:Description rdf:nodeID="commodity_pelt_cb15ee17a9d02222dc67d4f6ffa052fd17984bd3a2dfec9aad72360dce14c62eca8">
    <crm:P190_has_symbolic_content>pelt / peltry: an animal skin with the hair, wool or fur still attached, as traded raw or dressed by skinners and furriers; also peltry (peltria, peltry) for skins collectively, and old or low-quality skins. Specific skins are distinguished by the animal, treatment (raw, tanned, tawed), colour, origin and quality qualifiers below; named animal skins (rabbit, fox, lamb, marten, etc.) are catalogued under their own concepts.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
