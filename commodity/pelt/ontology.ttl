    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "pelt / peltry: an animal skin with the hair, wool or fur still attached, as traded raw or dressed by skinners and furriers; also peltry (peltria, peltry) for skins collectively, and old or low-quality skins. Specific skins are distinguished by the animal, treatment (raw, tanned, tawed), colour, origin and quality qualifiers below; named animal skins (rabbit, fox, lamb, marten, etc.) are catalogued under their own concepts." ;
            crm:P2_has_type aat:300435416 ] ;
