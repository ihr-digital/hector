    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "sandalwood: a scented wood obtained from several species of Santalum, also an inodorous dye-wood, used as a dye, a spice and in medicine (OED s.v. sandal n.2, sandalwood n.; MED s.v. saundre). Includes white sandalwood (Santalum album), red sandalwood / rubywood (Pterocarpus santalinus), yellow sandalwood, and the trunk or stem (stock) of the sandalwood tree." ;
            crm:P2_has_type aat:300435416 ] ;
