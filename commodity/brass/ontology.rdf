  <rdf:Description rdf:nodeID="commodity_brass_cb4339893ea03b9025dd5bc532eab3725b644d1921ce09c99900fc897586381c99">
    <crm:P190_has_symbolic_content>Alloy of copper and zinc, usually with copper as the major alloying element and zinc up to 40% by weight. For an alloy consisting mainly of copper, combined most often with tin, but at times also with other metals, use "bronze (metal)." [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
