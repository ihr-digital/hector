  <rdf:Description rdf:nodeID="commodity_bast_cb12634e6d4e8dd320f3b4d2c4c34126e1ad04ec009c2f7e8932ddca04588709783">
    <crm:P190_has_symbolic_content>Strong, woody fibers obtained from the phloem tissues (from the bark, stems, and leaves) of many plants, used for textiles, rope, and paper. Such fibers are characterized by fineness and flexibility. They are derived from flax, hemp, ramie, jute, abaca, cantala, henequen, sisal, pineapple, mitsumata, gampi, kozo, and other plants. Strong, woody fibers obtained from the phloem tissues (from the bark, stems, and leaves) of many plants, used for textiles, rope, and paper. Such fibers are characterized by fineness and flexibility. They are derived from flax, hemp, ramie, jute, abaca, cantala, henequen, sisal, pineapple, mitsumata, gampi, kozo, and other plants. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
