    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Strong, woody fibers obtained from the phloem tissues (from the bark, stems, and leaves) of many plants, used for textiles, rope, and paper. Such fibers are characterized by fineness and flexibility. They are derived from flax, hemp, ramie, jute, abaca, cantala, henequen, sisal, pineapple, mitsumata, gampi, kozo, and other plants. Strong, woody fibers obtained from the phloem tissues (from the bark, stems, and leaves) of many plants, used for textiles, rope, and paper. Such fibers are characterized by fineness and flexibility. They are derived from flax, hemp, ramie, jute, abaca, cantala, henequen, sisal, pineapple, mitsumata, gampi, kozo, and other plants. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
