  <rdf:Description rdf:nodeID="commodity_storax_cb1dc5a3f45750f8c7605bbd31b1612f6ed6e28e741712738d384ec285a89fbe295">
    <crm:P190_has_symbolic_content>the resin of the tree Styrax officinalis; in later commercial and pharmaceutical use the balsam of the tree Liquidambar orientale, used medically (OED s.v. storax; Latham, Word-List, s.v. 2 calamita) | probably storax, from the Portuguese form of the word (estoraque) (see also calamyta, storax)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
