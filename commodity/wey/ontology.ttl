    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "wey, a measure of weight, usually equal to twelve stone or c. 300 lb. (OED s.v. waw, n.2, wey1; Zupko 434-8), used for dry goods including salt, cheese, glass, tallow, sheep tallow (cepum moltonis), butter, thrumes, and battery; as a packing unit for glass containing 60 bunches (also 60 bunches for Renishe window glass), and for salt containing 40 bushels; note 7 centene = 80 vagas | clearly some kind of measure of salt, but exact meaning unknown" ;
            crm:P2_has_type aat:300435416 ] ;
