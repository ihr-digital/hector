  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "wey, a measure of weight, usually equal to twelve stone or c. 300 lb. (OED s.v. waw, n.2, wey1; Zupko 434-8), used for dry goods including salt, cheese, glass, tallow, sheep tallow (cepum moltonis), butter, thrumes, and battery; as a packing unit for glass containing 60 bunches (also 60 bunches for Renishe window glass), and for salt containing 40 bushels; note 7 centene = 80 vagas | clearly some kind of measure of salt, but exact meaning unknown"
    }
  ],
