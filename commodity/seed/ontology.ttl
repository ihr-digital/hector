            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "seːdəs" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "The characteristic reproductive bodies of both angiosperms (flowering plants) and gymnosperms (conifers, cycads, and ginkgos) and the ovary that encloses it. A seed consists of a miniature undeveloped plant (the embryo), which, alone or in the company of stored food for its early development after germination, is surrounded by a protective coat (the testa). Seeds are frequently small in size and suited to perform a wide variety of functions, such as multiplication, perennation (surviving seasons of stress such as winter), dormancy (a state of arrested development), and dispersal.  [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/seed> ;
    skos:related <https://w3id.org/hector/commodity/fennel>,
        <https://w3id.org/hector/commodity/mustard-seed>,
