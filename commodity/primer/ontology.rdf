  <rdf:Description rdf:nodeID="commodity_primer_cb1ecc7f757a3a1e39a22f086c05ed1f2f2d3835e8576e93a9b1f0d361a9624e9c9">
    <crm:P190_has_symbolic_content>Elementary books for teaching children to read. [Source: Getty AAT] | a printed prayer book for the use of the laity (OED s.v. primer n.1 1, 2a), here small | a printed prayer book for the use of the laity (OED s.v. primer n.1 1, 2a), here written (printed?) on parchment and bound in velvet | an elementary school-book for teaching children to read (OED s.v. primer n.^1 2a) | a printed prayer book for the use of the laity (OED s.v. primer n.1 1, 2a) | an elementary school-book for teaching children to read, less likely a printed prayer book for the use of the laity for understanding the (Latin) mass (OED s.v. primer n.1 1, 2a) | either a printed prayer book for the use of the laity or an elementary school-book for teaching children to read (OED s.v. primer n.1 1, 2a) | probably a prayer book rather than an elementary school-book (since only one was imported) | either a printed prayer book for the use of the laity (to follow the Latin mass) or an elementary school-book for teaching children to read (OED s.v. primer n.1 1, 2a) | an elementary school-book for teaching children to read (OED s.v. primer n.1 1, 2a)</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
