    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Close-fitting waist-length or hip-length garments with or without sleeves worn by men from the 15th to the 17th century and for similar garments reinforced by mail and worn under armor. Also refers to sleeved, hip-length garments worn as part of military uniforms by the Scottish units of the British army after 1855. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
