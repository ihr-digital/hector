  <rdf:Description rdf:nodeID="commodity_plaster_cb1567c091606f2e2da8f0bd99b11185d8a3e7c549cfce4e0bb9f857eea3bbb6361">
    <crm:P190_has_symbolic_content>Refers to a soft, plastic material that can be spread or daubed on a wall, ceiling, or other surface, where it afterwards hardens. In the context of art and architecture, it generally refers specifically to a mixture of water, lime, and sand, often combined with other materials, such as animal hair, to give the resulting material strength, texture, and if the surface is to be painted, porosity. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
