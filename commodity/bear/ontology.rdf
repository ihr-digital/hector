  <rdf:Description rdf:nodeID="commodity_bear_cbf6583e00349983061beb20b16c5da7719663625ca6991bbe665fcaa2b28890b1">
    <crm:P190_has_symbolic_content>Family containing nine species in six genera, characterized as being large, short-tailed, having stocky legs, a long snout, shaggy hair, and plantigrade paws with five non-retractile claws. Bears are generally omnivorous, but some bears are entirely carnivorous (like the polar bear ) or vegetarian (like the panda). [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
