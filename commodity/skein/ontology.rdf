  <rdf:Description rdf:nodeID="commodity_skein_cb1b80305d0f6d3e822b2061ad6e7582e26496dcf63ec88ef4646c4a27e56e99689">
    <crm:P190_has_symbolic_content>skein: a quantity of thread or yarn wound to a certain length on a reel (OED s.v. skein n.1); used as a measure of thread (white, Prussian, cable thread), silk, and gold-and-silver thread (5 talea per skein). The 'long skein' is a standardized large reel — the c (hundred) containing 120 lb (Book of Rates 39).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
