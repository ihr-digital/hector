  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "skein: a quantity of thread or yarn wound to a certain length on a reel (OED s.v. skein n.1); used as a measure of thread (white, Prussian, cable thread), silk, and gold-and-silver thread (5 talea per skein). The 'long skein' is a standardized large reel — the c (hundred) containing 120 lb (Book of Rates 39)."
    }
  ],
