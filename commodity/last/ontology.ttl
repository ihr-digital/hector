    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Last (Latin lastus/lasta): a large unit of quantity, weight or packing whose size varied by commodity. As a measure of weight, c. 1870 kg (= 12 barrels); as a packing unit for liquid goods, usually 12 barrels; as a counting unit for hides, 200 pieces (= 20 dickers); for fish c. 1000 (croplings, herring, sprats); also used for eels, rye, soap, tar, pitch, butter, oil and bowstaves (24 bundles of 16 staves). Distinct from the shoemaker's last (a foot-shaped mould) and from lastage/ballast." ;
            crm:P2_has_type aat:300435416 ] ;
