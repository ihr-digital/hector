  <rdf:Description rdf:nodeID="commodity_shallot_cb936fabc020cefa9bbab931f6ea2580eec0e9721e0e0838124da20d3a6ce583ce">
    <crm:P190_has_symbolic_content>Edible rounded bulbs of Allium cepa, which consist of fleshy concentric leaf-bases. Onions have a strong pungent flavour and smell, and vary in color from white to yellow and dark red, and are used as a culinary vegetable throughout the world, eaten raw, cooked, or pickled. [Source: Getty AAT] | edible bulb of the shallot plant (Allium cepa var. aggregatum); for the plant use Q193498 [Source: Wikidata]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
