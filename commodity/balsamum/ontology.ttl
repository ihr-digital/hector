<https://w3id.org/hector/commodity/balsamum> a crm:E55_Type ;
    rdfs:label "balsamum" ;
    dcterms:modified "2026-09-29"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "balsamum" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "balsamum" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "balsami" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "balsami" ;
            hector:validFrom "1390"^^xsd:gYear ;
            hector:validThrough "1390"^^xsd:gYear ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "An oleoresinous exudate from coniferous trees, especially of the Pinus genus. Balsams have been used since antiquity for medicinal purposes and as sealers. The exudate is a soft, semi-liquid consisting of terpenes of resinous character and a large amount of essential oils. Upon distillation, a liquid portion, called turpentine, and a solid residue, called rosin, are produced. Balsams have been used in varnishes and paint mediums; however, they deteriorate easily unless a harder resin is mixed with them. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/balsamum> ;
    skos:related <https://w3id.org/hector/commodity/carpobalsamum>,
        <https://w3id.org/hector/commodity/oil> ;
    la:equivalent aat:300012891 ;
    hector:attestationCount 2 ;
    hector:taxation <https://w3id.org/hector/commodity/balsamum#rate-1558-inward-415> .

