            crm:P2_has_type hector:AttestedVariant ] ;
    hector:sourceText "Book of Rates 1558, inward, line 415 (transcribed by Stuart Jenks): 'Excella balsami the pounde' 6s 8d" ;
    hector:validFrom "1558"^^xsd:gYear ;
    hector:validThrough "1604"^^xsd:gYear .

