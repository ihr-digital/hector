    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Tags or ornaments at the ends of laces, ribbons, or points that tie garments or footwear. Also refers to any of various ornamental tags, studs, or plates worn on costume; may be at pendent end of a cord or similar object or sewn directly onto garments or headgear. [Source: Getty AAT]" ;
