    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "the genet (also jenet), a kind of civet-cat native to southern Europe, west Asia and Africa; (pl.) the skins of the animal employed as fur for garments (Veale 219). Black skins were more valuable than grey; the best were taken in season, i.e. killed in winter when the animal is normally hunted (Veale 25)." ;
            crm:P2_has_type aat:300435416 ] ;
