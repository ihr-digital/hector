  <rdf:Description rdf:nodeID="commodity_fig_cb1836f1a318effa7784a1c6a821ccde28c39dbc89beb0eacabf342c98f301de550">
    <crm:P190_has_symbolic_content>Fruits of the fig tree. Figs are syconia, inflorescences formed by an enlarged, fleshy, hollow receptacle with multiple ovaries on the inside surface. Figs are borne singly or in pairs above the scars of fallen leaves or in axils of leaves of the present season.  [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
