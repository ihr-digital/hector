    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Gun / cannon (OED s.v. gun 1a): a piece of ordnance, of iron or brass, in various sizes (from great cannon to the small 'base' and 'demi-hawk'), some breech-loading 'with chambers'. See also gunstone, gunpowder, hand gun, gune horn (powder-horn) and gonnelack (gunlock)." ;
