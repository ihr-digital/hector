  <rdf:Description rdf:nodeID="commodity_gun_cbe5f9b713a06ae9a7102038db3fbf9507153a5b50589bab20677f5c2f313ded10">
    <crm:P190_has_symbolic_content>Gun / cannon (OED s.v. gun 1a): a piece of ordnance, of iron or brass, in various sizes (from great cannon to the small 'base' and 'demi-hawk'), some breech-loading 'with chambers'. See also gunstone, gunpowder, hand gun, gune horn (powder-horn) and gonnelack (gunlock).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
