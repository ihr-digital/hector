  <rdf:Description rdf:nodeID="commodity_goshawk_cb1180db9a54c17c10be61ecd826243e282f2f3169c59c0227b4638376478f390b0">
    <crm:P190_has_symbolic_content>a large, short-winged hawk (OED s.v. goshawk) | goshawk, a large, short-winged hawk (OED s.v. goshawk) | goshawk is a large, short-winged hawk (OED s.v. goshawk); rama is copper wire, so some sort of snare for goshawks is a conceivable meaning for the term. However, since the following words are completely illegible, this could easily be wrong</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
