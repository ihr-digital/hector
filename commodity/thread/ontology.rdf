  <rdf:Description rdf:nodeID="commodity_thread_cb1b12bf717d8ef0f7f7d8efcd779ad9208b1582264aad383ec0c3a81387fd0ce7c">
    <crm:P190_has_symbolic_content>Filum (Latin): thread or yarn. Traded in many materials (linen, cotton, wool, silk, worsted/crewel, and metal threads of gold, silver, copper and latten), colours, qualities, forms (skeins, bottoms, ribbon, wire) and uses (sewing, binding, piecing, packthread, sail-, net- and crossbow-thread), and from many places of manufacture (Cologne, Bruges, Oudenarde, Doornik, Burgundy, Prussia, Paris, Lyons, etc.).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
