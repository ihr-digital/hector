  <rdf:Description rdf:nodeID="commodity_pitch_cb1e8326544dd0ad54623fd897c09869bbcaa24f5e772cc0eb7c326a6371785b1d0">
    <crm:P190_has_symbolic_content>A sticky, black residue obtained from the distillation of coal tar, petroleum, or pine tar. Pitch is used as a sealant and wood preservative as well as a component in roofing, paving, and water proofing. [Source: Getty AAT]</crm:P190_has_symbolic_content>
