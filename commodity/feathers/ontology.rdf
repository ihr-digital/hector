  <rdf:Description rdf:nodeID="commodity_feathers_cb142f21808406af83e52448e93b7e795f811b1b5148d7cd1d99e021cd20dc53cf7">
    <crm:P190_has_symbolic_content>Feather (OE feþer; Latin pluma). Bird plumage traded for ornament, dress, bedding and for fletching arrows; recorded especially as ostrich and pheasant feathers. See also swan feathers.</crm:P190_has_symbolic_content>
