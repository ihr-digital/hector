  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "poke: a bag, pouch or sack used as a packing unit and measure (a bale) for wool, hops, flax, meal, coal, feathers and similar dry goods, mostly of no particular size; as a measure of weight for hops about 4 cwt at 112 lb./cwt (a small poke / pokett about 3 cwt), equivalent to half a sack (Zupko 308-9; Willan 33). The diminutive pokett(e)/pokettus is a small poke (cf. pocket). See also sack, bale, pack."
    }
  ],
