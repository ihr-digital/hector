  <rdf:Description rdf:nodeID="commodity_poke_cbe053363f0a9b00bcb9c3aaa5cde3be6814a568a194e38637bafa9d4518b31ee7">
    <crm:P190_has_symbolic_content>poke: a bag, pouch or sack used as a packing unit and measure (a bale) for wool, hops, flax, meal, coal, feathers and similar dry goods, mostly of no particular size; as a measure of weight for hops about 4 cwt at 112 lb./cwt (a small poke / pokett about 3 cwt), equivalent to half a sack (Zupko 308-9; Willan 33). The diminutive pokett(e)/pokettus is a small poke (cf. pocket). See also sack, bale, pack.</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
