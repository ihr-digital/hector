    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Dishes supplied with a heat source (such as a fuel lamp or candle) used for cooking or keeping food warm. The term is sometimes applied to vessels containing charcoal or other fuel and upon which another container with food may be placed. [Source: Getty AAT]" ;
