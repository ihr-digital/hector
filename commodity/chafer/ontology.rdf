  <rdf:Description rdf:nodeID="commodity_chafer_cb16de98f0a628b856ac511f3bd396af5d69f883562b41d8d42cb3d957da8edc17b">
    <crm:P190_has_symbolic_content>Dishes supplied with a heat source (such as a fuel lamp or candle) used for cooking or keeping food warm. The term is sometimes applied to vessels containing charcoal or other fuel and upon which another container with food may be placed. [Source: Getty AAT]</crm:P190_has_symbolic_content>
