  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "An alcoholic beverage obtained by the fermentation of malt from cereal grain (or another saccharine substance), flavored with hops or other aromatic bitters. Formerly the term was used as distinct from \"ale,\" with beer being hopped; now \"ale\" is used to describe a type of beer. May also be applied as a generic reference to other fermented liquors of various kinds, flavored by various ingredients such as ginger. [Source: Getty AAT]"
    }
  ],
