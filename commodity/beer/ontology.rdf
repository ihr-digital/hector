  <rdf:Description rdf:nodeID="commodity_beer_cb1295da48039a566a9f3f3196697f96396a0ad77adfa3c45d5fe966737b9d74557">
    <crm:P190_has_symbolic_content>An alcoholic beverage obtained by the fermentation of malt from cereal grain (or another saccharine substance), flavored with hops or other aromatic bitters. Formerly the term was used as distinct from "ale," with beer being hopped; now "ale" is used to describe a type of beer. May also be applied as a generic reference to other fermented liquors of various kinds, flavored by various ingredients such as ginger. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
