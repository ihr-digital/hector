  <rdf:Description rdf:nodeID="commodity_point_cb1f11ca391a3a78b51a710d71ebeb82e66f2338f743029517f205086ec75828e6d">
    <crm:P190_has_symbolic_content>a point: a tagged lace or cord of twisted yarn, silk, thread or leather, used for attaching the hose to the doublet, lacing a bodice and fastening various parts of clothing (OED s.v. point n.1 II.5; MED s.v. lasinge 3). Includes the lacing point (lasyng/lacyng poynt).</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
