    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "nail (see also clavus) | nail (cf. clavus) | nail | nails 481, 484 (see also clavus) | nail for making brigandines, body-armor for foot-soldiers made of iron rings or small thin iron plates sewn onto canvas, linen or leather and covered with a similar material. Originally in pairs (front and back), ergo often in the plural (OED s.v. brigandine) | 25, | arming-nail, forming part of armor (OED arming vgl. n. 1b) | nail for making brigandyns | middle quality nails" ;
            crm:P2_has_type aat:300435416 ] ;
