    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Hand operated cutting implements resembling scissors but of larger size, or any other cutting instruments that similarly operate by the simultaneous action of two blades on opposite sides of the material to be cut. The term may also be used for various machines used for cutting that are more or less analogous to shears in manner of operation. [Source: Getty AAT] | Cutting tools consisting of two bevel-edged cutting blades and handles, and being movable past one another on a pivot in the center by which they are held together. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
