  <rdf:Description rdf:nodeID="commodity_partisan_cb1695bb039da4c36175af2413fe29ab0a6d69704363008ae02d70e8d3dbc814efa">
    <crm:P190_has_symbolic_content>Staff weapons having a broad, tapering triangular blade with two upturned lugs or wings at the base, used as thrusting and cutting weapons but also extremely popular as ceremonial weapons from the 16th to the 19th century, and still occasionally used as such today. [Source: Getty AAT]</crm:P190_has_symbolic_content>
    <crm:P2_has_type rdf:resource="http://vocab.getty.edu/aat/300435416"/>
    <rdf:type rdf:resource="http://www.cidoc-crm.org/cidoc-crm/E33_Linguistic_Object"/>
  </rdf:Description>
