    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "A natural organic colorant extracted from the roots of any of several species of the genus Rubia, having a reddish color. Madder has been used as a colorant for dyeing textiles since ancient times in India, Persia, and Egypt. It has been largely replaced as a dye and a pigment by synthetic alizarin. Used for dye and lake pigment preparation. [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
