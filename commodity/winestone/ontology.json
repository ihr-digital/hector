  "referred_to_by": [
    {
      "type": "LinguisticObject",
      "classified_as": [
        {
          "id": "aat:300435416",
          "type": "Type",
          "_label": "descriptive note"
        }
      ],
      "content": "winestone, the deposit of crude tartar or argol found in wine-casks (OED s.v. wine n.1 9a) (see also argel, vynstone, winstone); specifically, bitartrate of potash (acid potassium tartrate), present in grape juice, deposited in a crude form in the process of fermentation and adhering to the sides of wine-casks as a hard crust; when purified it becomes cream of tartar (OED s.v. tartar n.1, argol1); used medicinally (MED s.v. argoille, OED s.v. argol1) and in glassmaking | archil, a name given to various species of lichens (Roccella tinctoria, etc.) which yield a violet dye and the chemical test substance litmus; also the colouring-matter prepared from these lichens (OED s.v. archil)"
    }
  ],
