    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "towel, a cloth, usually of linen or hemp, for wiping something dry, especially for wiping the hands, face, or person after washing or bathing. Also formerly more widely, including a table-napkin or other cloth used at meals (OED s.v. towel n.), made of diaper, a linen fabric (or an inferior fabric of 'union' or cotton) woven with a small and simple pattern, formed by the different directions of the thread, with the different reflexions of light from its surface, and consisting of lines crossing diamond-wise, with the spaces variously filled up by parallel lines, a central leaf or dot, etc. (OED s.v. diaper)" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/towelling%20diaper> ;
