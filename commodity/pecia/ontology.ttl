            rdfs:label "Buckroms" ;
            crm:P2_has_type hector:AttestedVariant ] ;
    hector:sourceText "Book of Rates 1507, line 10 (transcribed by Stuart Jenks): 'Buckroms in paperes, every paper 1 with another fyne þat ys to saye 3 peces in every papere' 6s 8d" ;
    hector:validFrom "1507"^^xsd:gYear ;
    hector:validThrough "1545"^^xsd:gYear .

