            crm:P180_has_currency aat:300411998 ;
            hector:lsd "6s 8d" ;
            hector:valueInPence 80.0 ] ;
    hector:perQuantity [ a crm:E54_Dimension ;
            crm:P90_has_value 1 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/paper> ] ;
