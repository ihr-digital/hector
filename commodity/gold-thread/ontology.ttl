    hector:amount [ a crm:E97_Monetary_Amount ;
            crm:P180_has_currency aat:300411998 ;
            hector:lsd "40s" ;
            hector:valueInPence 480.0 ] ;
    hector:perQuantity [ a crm:E54_Dimension ;
            crm:P90_has_value 12 ;
            crm:P91_has_unit <https://w3id.org/hector/unit/dozen> ] ;
    hector:qualifier [ a crm:E55_Type ;
            rdfs:label "Crippins cum" ;
            crm:P2_has_type hector:AttestedVariant ] ;
    hector:sourceText "Book of Rates 1558, inward, line 286 (transcribed by Stuart Jenks): 'Crippins cum auro the dossen' 40s" ;
