<https://w3id.org/hector/commodity/gold-thread> a crm:E55_Type ;
    rdfs:label "gold thread" ;
    dcterms:modified "2026-10-03"^^xsd:date ;
    crm:P1_is_identified_by [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "gold thread" ;
            crm:P2_has_type aat:300404670,
                hector:AttestedVariant ;
            hector:phoneticKey "gold θrɛːd" ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "aurum" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "aurum" ;
            hector:validFrom "1400"^^xsd:gYear ;
            hector:validThrough "1421"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "auri" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "auri" ;
            hector:validFrom "1400"^^xsd:gYear ;
            hector:validThrough "1421"^^xsd:gYear ],
        [ a crm:E33_E41_Linguistic_Appellation ;
            crm:P190_has_symbolic_content "auro" ;
            crm:P2_has_type hector:AttestedVariant ;
            hector:phoneticKey "auro" ] ;
    crm:P67i_is_referred_to_by [ a crm:E33_Linguistic_Object ;
            crm:P190_has_symbolic_content "Fiber or fiber-like material made wholly or in part from gold [Source: Getty AAT]" ;
            crm:P2_has_type aat:300435416 ] ;
    skos:exactMatch <https://w3id.org/mlca/glossary/gold%20thread> ;
    skos:related <https://w3id.org/hector/commodity/gold-leaf>,
        <https://w3id.org/hector/commodity/roll> ;
    la:equivalent aat:300400561 ;
